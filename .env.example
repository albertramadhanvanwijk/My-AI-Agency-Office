# Database
DATABASE_URL="postgresql://user:password@localhost:5432/myaiagencyoffice?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Gateway (server-only — never NEXT_PUBLIC)
NINE_ROUTER_API_KEY=""
NINE_ROUTER_BASE_URL="https://api.9router.com/v1"

# Redis / BullMQ (optional in dev/CI — queue gracefully skipped when unset)
# Use REDIS_URL for hosted Redis (Upstash/Redis Cloud). Examples:
# REDIS_URL="redis://localhost:6379"
# REDIS_URL="redis://:s3cret@redis.example.com:6380"
# REDIS_URL="rediss://:s3cret@redis.example.com:6380"  # TLS
REDIS_URL=""
# Alternative split vars (used when REDIS_URL is empty):
# REDIS_HOST="localhost"
# REDIS_PORT="6379"

# Realtime (Socket.io) — server.ts listens on this port; Vercel: not used
REALTIME_PORT="3001"

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"
